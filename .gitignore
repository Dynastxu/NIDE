node_modules
dist
out
.DS_Store
.eslintcache
*.log*
/.idea/
/.vscode/

# 工程编排（composite）的增量缓存：tsc 与 IDE 都会在仓库根写它，
# 每次分析都可能变，不该进版本库（npm run typecheck 传了 --composite false，不写它）
*.tsbuildinfo

# Github Wiki
/docs/wiki/

# 本地开发用的 NIDE_HOME（profile / patch / 插件）
/.nide-dev/
# 打包产物跑起来的 profile（`pnpm host:dist:smoke` 会写入）
/.nide-dist/
# 临时文件（构建 / 验证脚本用）
/.tmp/

# 插件浏览器半的构建产物
/plugins/builtin/*/dist/
