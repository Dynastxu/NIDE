{
  "name": "nide",
  "productName": "NIDE",
  "version": "0.0.0",
  "description": "AI 辅助的小说工程化 IDE 编辑器",
  "main": "./out/main/index.js",
  "author": "Dynastxu <dynastxu@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynastxu/NIDE.git"
  },
  "homepage": "https://github.com/Dynastxu/NIDE#readme",
  "bugs": "https://github.com/Dynastxu/NIDE/issues",
  "license": "AGPL-3.0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "typecheck:host": "tsc --noEmit -p tsconfig.host.json",
    "host:dev": "node packages/host/src/index.ts --profile desktop --home .nide-dev",
    "host:dump": "node packages/host/src/index.ts --profile desktop --home .nide-dev --dump-config",
    "host:smoke": "node packages/host/src/index.ts --profile desktop --home .nide-dev --reset --once",
    "build:plugin-clients": "node scripts/build-plugin-client.mjs",
    "build:plugin-demo": "node scripts/build-plugin-client.mjs --only demo",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/install-electron.mjs",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "ci": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/cordis-plugin-group": "1.0.5",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6",
    "@deepseek-ai/cordis-plugin-timer": "1.1.7",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@monaco-editor/loader": "^1.7.0",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "js-yaml": "4.3.2",
    "marked": "^14.0.0",
    "monaco-editor": "^0.57.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-react-click-to-component": "^4.2.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
