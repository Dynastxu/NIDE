{
  "name": "@nide/nide-root",
  "private": true,
  "productName": "NIDE",
  "version": "0.0.0",
  "description": "AI 辅助的小说工程化 IDE 编辑器",
  "main": "./out/main/index.js",
  "author": "Dynastxu <dynastxu@qq.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dynastxu/NIDE.git"
  },
  "homepage": "https://github.com/Dynastxu/NIDE#readme",
  "bugs": "https://github.com/Dynastxu/NIDE/issues",
  "license": "AGPL-3.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "lint:imports": "node scripts/check-imports.mts",
    "lint:domains": "node scripts/check-package-domains.mts",
    "gen:package-graph": "node scripts/gen-package-graph.mts",
    "graph:check": "node scripts/gen-package-graph.mts --check",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run typecheck && pnpm run lint:imports && pnpm run lint:domains && pnpm run graph:check && pnpm run lint && pnpm run format:check && pnpm run test",
    "typecheck:host": "tsc --noEmit -p tsconfig.host.json",
    "host:dev": "node packages/host/src/index.ts --profile desktop --home .nide-dev",
    "host:dump": "node packages/host/src/index.ts --profile desktop --home .nide-dev --dump-config",
    "host:smoke": "node packages/host/src/index.ts --profile desktop --home .nide-dev --reset --once",
    "build:plugin-clients": "node scripts/build-plugin-client.mjs",
    "build:plugin-demo": "node scripts/build-plugin-client.mjs --only demo",
    "gen:client-roster": "node scripts/gen-client-roster.mts",
    "predev": "pnpm run gen:client-roster",
    "prebuild": "pnpm run gen:client-roster",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "postinstall": "node scripts/install-electron.mjs",
    "build:unpack": "pnpm run build:dist && electron-builder --dir",
    "build:win": "pnpm run build:dist && electron-builder --win",
    "build:mac": "pnpm run build:dist && electron-builder --mac",
    "build:linux": "pnpm run build:dist && electron-builder --linux",
    "ci": "pnpm run check && pnpm run build",
    "build:host": "node scripts/build-host.mts",
    "host:dist": "node out/host/packages/host/src/index.js --profile desktop --home .nide-dist --app-root . --dist-root out/host",
    "host:dist:smoke": "node out/host/packages/host/src/index.js --profile desktop --home .nide-dist --app-root . --dist-root out/host --reset --once",
    "build:dist": "pnpm run build && pnpm run build:host"
  },
  "//dependencies": "只保留打包版 host / main / preload 运行时真正要 require 的依赖（electron-builder 从根 package.json 收集生产依赖）。各包自己的依赖写在各包 package.json 里；这里不重复客户端库，它们会被 Vite 打进 bundle。",
  "dependencies": {
    "@cordisjs/plugin-include": "1.2.0",
    "@cordisjs/plugin-loader": "1.0.0-rc.9",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "cordis": "4.0.0-rc.12",
    "electron-log": "^5.4.4",
    "js-yaml": "4.3.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@eslint-react/eslint-plugin": "^5.28.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.2.6",
    "vite-plugin-react-click-to-component": "^4.2.3",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.21.0"
}
